  m_Script: {fileID: 11500000, guid: fbfb04b119348794697a7f8018097ccf, type: 3}
  m_Name: DialogueReward
  m_EditorClassIdentifier: 
  sentences:
  - "\"\u0110\xE2y l\xE0 ph\u1EA7n th\u01B0\u1EDFng x\u1EE9ng \u0111\xE1ng cho n\u1ED7
    l\u1EF1c c\u1EE7a con.\",\r\n\"L\xE0m t\u1ED1t l\u1EAFm! Con \u0111\xE3 gi\xFAp
    \u0111\u1EE1 r\u1EA5t nhi\u1EC1u r\u1ED3i.\",\r\n\"H\xE3y nh\u1EADn l\u1EA5y
    ph\u1EA7n th\u01B0\u1EDFng \u0111i.\",\r\n\"C\u1EA3m \u01A1n con. Ng\u01B0\u1EDDi
    nh\u01B0 con, ph\xE1i Ninja r\u1EA5t t\u1EF1 h\xE0o.\",\r\n\"Ta mong s\u1EBD
    l\u1EA1i th\u1EA5y con quay v\u1EC1 v\u1EDBi nhi\u1EC7m v\u1EE5 ti\u1EBFp theo.\"\r"
